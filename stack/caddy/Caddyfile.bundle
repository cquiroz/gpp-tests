# Alternative front door that serves a locally-built Explore bundle instead of proxying
# Firebase dev hosting. Use it once lucuma-apps publishes the bundle as a CI artifact
# (spec §10 ask 3), or to test a specific Explore commit:
#
#   EXPLORE_BUNDLE_DIR=/path/to/explore/heroku/static \
#   CADDYFILE=./caddy/Caddyfile.bundle stack/scripts/bootstrap.sh
#
# The bundle directory is mounted at /srv/explore-bundle, and our environments.conf.json
# still wins over the one inside the bundle.

{
	admin off
	auto_https disable_redirects
}

explore.{$GPP_TEST_DOMAIN} {
	tls internal

	handle /environments.conf.json {
		root * /srv/explore
		header Cache-Control "no-store"
		header Content-Type "application/json"
		file_server
	}

	handle {
		root * /srv/explore-bundle
		try_files {path} /index.html
		file_server
	}
}

sso.{$GPP_TEST_DOMAIN} {
	tls internal
	reverse_proxy http://sso:8082
}

odb.{$GPP_TEST_DOMAIN} {
	tls internal
	# One upstream, or two when ODB_WEB_DYNOS=2. Random choice per request, as Heroku's
	# router spreads requests over dynos; a websocket stays on the process that accepted it.
	# lb_try_duration retries a refused connection on another upstream, so the second process
	# takes no traffic before it listens, as a dyno gets none before it binds its port.
	reverse_proxy {$ODB_UPSTREAMS:odb:8082} {
		lb_try_duration 5s
	}
}

itc.{$GPP_TEST_DOMAIN} {
	tls internal
	reverse_proxy http://itc:6060
}

prefs.{$GPP_TEST_DOMAIN} {
	tls internal
	reverse_proxy http://hasura:8080
}

# Mailgun's stand-in and the record of outgoing mail — the same blocks as Caddyfile, which
# explains them (ticket 028). No email can leave the stack.
api.mailgun.net {
	tls internal

	log {
		output file /data/mailgun.log {
			roll_size 10MiB
			roll_keep 2
		}
		format json
	}
	log_append body {http.request.body}

	handle /v3/*/messages {
		header Content-Type "application/json"
		respond `{"id":"<{http.request.uuid}@mail.example.com>","message":"Queued. Thank you."}` 200
	}

	handle /v3/*/events {
		header Content-Type "application/json"
		respond `{"items":[],"paging":{}}` 200
	}

	respond 404
}

mail.{$GPP_TEST_DOMAIN} {
	tls internal

	handle /mailgun.log {
		root * /data
		header Cache-Control "no-store"
		file_server
	}

	respond 404
}
