# TLS front door for the ephemeral stack (spec §3).
#
# `tls internal` uses Caddy's own CA: certificates are minted for the *.gpp-test.internal
# names on first request. Playwright accepts them (see playwright.config.ts), k6 runs with
# insecureSkipTLSVerify, and Node clients get the root via NODE_EXTRA_CA_CERTS — bootstrap
# exports it to stack/certs/caddy-root.crt.
#
# Explore is proxied from Firebase dev hosting (which tracks lucuma-apps main), so nothing
# has to build a Scala.js bundle in CI. The one file we override is environments.conf.json,
# which is what points the app at this stack. Swap CADDYFILE=./caddy/Caddyfile.bundle to
# serve a locally-built bundle instead (spec §10 ask 3).

{
	admin off
	auto_https disable_redirects
}

explore.{$GPP_TEST_DOMAIN} {
	tls internal

	# Our endpoints, not the dev environment's. Must not be cached: the PWA's service
	# worker keeps a copy under the `environments-config` cache.
	handle /environments.conf.json {
		root * /srv/explore
		header Cache-Control "no-store"
		header Content-Type "application/json"
		file_server
	}

	handle {
		reverse_proxy https://{$EXPLORE_ORIGIN} {
			header_up Host {$EXPLORE_ORIGIN}
			# Firebase Hosting serves the SPA fallback itself, so no rewrite is needed.
		}
	}
}

sso.{$GPP_TEST_DOMAIN} {
	tls internal
	reverse_proxy http://sso:8082
}

odb.{$GPP_TEST_DOMAIN} {
	tls internal
	# Covers both /odb (GraphQL over HTTP) and /ws (graphql-ws); reverse_proxy upgrades
	# websockets transparently.
	reverse_proxy http://odb:8082
}

itc.{$GPP_TEST_DOMAIN} {
	tls internal
	reverse_proxy http://itc:6060
}

prefs.{$GPP_TEST_DOMAIN} {
	tls internal
	reverse_proxy http://hasura:8080
}

# Mailgun's stand-in (ticket 028). The odb emails the PI on every proposal submission and
# its Mailgun base URL is hardcoded (lucuma-odb Config.scala: "add to environment?"), so the
# stack answers for api.mailgun.net itself: docker-compose.yml aliases the name to this
# container, the certificate is minted by the same internal CA, and the odb trusts that CA
# through the merged truststore bootstrap builds (stack/scripts/java-truststore.sh). The
# odb decodes `id` and `message` from the send reply (EmailService.scala) and strips the
# angle brackets Mailgun puts around the id.
#
# No email can leave the stack: this name never resolves to Mailgun from inside the compose
# network, the odb's MAILGUN_API_KEY is a dummy that real Mailgun refuses with 401 anyway,
# and the recipients are the fabricated users' @<domain> addresses. What the odb *tried* to
# send is recorded instead — every request's form body goes into the access log below, which
# the `mail.` site serves back so a test can assert that the submission email was handed
# over, to whom, and with which subject.
api.mailgun.net {
	tls internal

	log {
		output file /data/mailgun.log {
			roll_size 10MiB
			roll_keep 2
		}
		format json
	}
	log_append body {http.request.body}

	handle /v3/*/messages {
		header Content-Type "application/json"
		respond `{"id":"<{http.request.uuid}@mail.example.com>","message":"Queued. Thank you."}` 200
	}

	handle /v3/*/events {
		header Content-Type "application/json"
		respond `{"items":[],"paging":{}}` 200
	}

	respond 404
}

# The record of what the odb handed to the stand-in above, one JSON line per request, read by
# tests/support/mail.ts and lib/mail.js. Only that file: /data also holds Caddy's CA keys.
mail.{$GPP_TEST_DOMAIN} {
	tls internal

	handle /mailgun.log {
		root * /data
		header Cache-Control "no-store"
		file_server
	}

	respond 404
}
