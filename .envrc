use flake

# Local secrets, so HEROKU_API_KEY and the Grafana tokens do not have to be exported by hand
# every session. .env is gitignored:
#
#   HEROKU_API_KEY=...
#   GRAFANA_URL=https://myorg.grafana.net
#   GRAFANA_ANNOTATIONS_TOKEN=...
#   K6_PROMETHEUS_RW_SERVER_URL=https://prometheus-prod-XX-<region>.grafana.net/api/prom/push
#   K6_PROMETHEUS_RW_USERNAME=<numeric instance id>
#   K6_PROMETHEUS_RW_PASSWORD=glc_...   (Access Policy token, metrics:write)
dotenv_if_exists .env
