{
  "uid": "gpp-test-results",
  "title": "GPP test results",
  "description": "Nightly load latency, error trend and regression pass/fail history for the gpp-tests suites. Run identity comes from the gpp-tests annotations, not from metric labels (spec §7). Every query is a last_over_time(...[1d]) range: a regression run pushes one sample per series and stales it two seconds later, which a plain instant query at dashboard step widths never lands on; the range makes each night a step until the next.",
  "tags": [
    "gpp-tests",
    "gpp"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "gpp-tests runs",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "target": {
          "limit": 200,
          "matchAny": false,
          "tags": [
            "gpp-tests"
          ],
          "type": "tags"
        }
      },
      {
        "name": "threshold breaches",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "target": {
          "limit": 200,
          "matchAny": false,
          "tags": [
            "gpp-tests",
            "breach"
          ],
          "type": "tags"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Read p95 by operation",
      "description": "Night-over-night read latency. The nightly claim is relative: a step up here is the regression signal, not the absolute value. The dashed grey line on the right axis is k6_vus — latency and errors are only interpretable against the load that produced them.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "always",
            "lineInterpolation": "stepAfter",
            "pointSize": 5
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2000
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "VUs"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "virtual users"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    4
                  ]
                }
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#909090"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "last_over_time(k6_odb_read_duration_p95[1d])",
          "legendFormat": "{{suite}} · {{operation}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "max_over_time(k6_vus[1d])",
          "legendFormat": "VUs"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Write p95 by operation",
      "description": "Mutation latency. The spec's absolute cap is 5 s; the armed threshold is usually tighter, derived from the baseline median. The dashed grey line on the right axis is k6_vus — latency and errors are only interpretable against the load that produced them.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "always",
            "lineInterpolation": "stepAfter",
            "pointSize": 5
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "VUs"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "virtual users"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    4
                  ]
                }
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#909090"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "last_over_time(k6_odb_write_duration_p95[1d])",
          "legendFormat": "{{suite}} · {{operation}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "max_over_time(k6_vus[1d])",
          "legendFormat": "VUs"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate",
      "description": "Share of failed HTTP requests. The armed threshold is 1%. The dashed grey line on the right axis is k6_vus — latency and errors are only interpretable against the load that produced them.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 3,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "lineInterpolation": "stepAfter",
            "showPoints": "always",
            "pointSize": 5
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "VUs"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "virtual users"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    4
                  ]
                }
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#909090"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "last_over_time(k6_http_req_failed_rate[1d])",
          "legendFormat": "{{suite}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "max_over_time(k6_vus[1d])",
          "legendFormat": "VUs"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Regression scenario pass rate",
      "description": "1 = the scenario passed in that run. Gaps are runs that never got as far as the scenario; check the run's annotation for the CI link.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 4,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "points",
            "pointSize": 6,
            "lineWidth": 1,
            "showPoints": "always",
            "lineInterpolation": "stepAfter"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "last_over_time(k6_gpp_scenario_pass_rate{suite=\"regression\"}[1d])",
          "legendFormat": "{{scenario}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Scenario duration p95",
      "description": "How long each scenario takes, both suites. A scenario getting slower without a threshold breach is the early warning.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 5,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "lineInterpolation": "stepAfter",
            "showPoints": "always",
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "last_over_time(k6_gpp_scenario_duration_p95[1d])",
          "legendFormat": "{{suite}} · {{scenario}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GraphQL errors",
      "description": "ODB responses carrying a GraphQL `errors` array. Any sustained value here is a functional problem, not a performance one.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 6,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 40,
            "lineInterpolation": "stepAfter",
            "showPoints": "always",
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (operation) (last_over_time(k6_odb_graphql_errors_total[1d]))",
          "legendFormat": "{{operation}}"
        }
      ]
    }
  ]
}
